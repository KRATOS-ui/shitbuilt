# ---------------------------------------------------------------------------
# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.
# ---------------------------------------------------------------------------

# OBLIGATORIO. Clave para firmar los tokens JWT, en Base64 (minimo 256 bits).
# Generala con:   openssl rand -base64 32
JWT_SECRET=

# Contrasena de PostgreSQL (opcional; por defecto "rootpassword", cambiala fuera de desarrollo).
DB_PASSWORD=

# Gemini (creacion de eventos con IA). Es opcional: sin clave, el sistema funciona y la
# opcion de IA avisa que no esta configurada. Obtenla en Google AI Studio.
GEMINI_API_KEY=
# Modelo de Gemini (el "-latest" liviano responde en ~2 s)
GEMINI_MODEL=gemini-flash-lite-latest
# Tiempo maximo de espera de la IA en segundos (RNF de usabilidad: ~5 s).
GEMINI_TIMEOUT_SECONDS=5

# Notificaciones por correo (RF-08). Opcional: si MAIL_HOST esta vacio, los correos no se envian
# y se escriben en el log del backend (docker compose logs -f backend).
# Ejemplo Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, usuario = tu correo, clave = "contrasena de aplicacion".
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@syncflow.local

# Origenes permitidos por CORS (separados por coma). Cambialo si publicas el frontend en otro dominio.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5174

# URL del backend vista desde el navegador (se incrusta al construir el frontend).
VITE_API_URL=http://localhost:8080/api
